{
  "name": "@shulex/cxclawctl",
  "version": "0.1.22",
  "description": "Solvea CXClaw CLI and Codex plugin runtime",
  "type": "module",
  "bin": {
    "cxclawctl": "./bin/cxclawctl.mjs"
  },
  "files": [
    "bin",
    "dist/cli.js",
    "dist/cli.js.map",
    "dist/mcp-apps"
  ],
  "scripts": {
    "build:server": "tsup",
    "build:mcp-apps": "tsx scripts/build-mcp-apps.ts",
    "build": "bun run build:server && bun run build:mcp-apps",
    "dev:mcp-apps": "tsx scripts/build-mcp-apps.ts --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "tsx src/cli.ts",
    "dev:plugin": "tsx scripts/dev-plugin.ts sync",
    "dev:plugin:prepare": "tsx scripts/dev-plugin.ts prepare",
    "dev:plugin:watch": "tsx scripts/dev-plugin.ts watch",
    "dev:plugin:status": "tsx scripts/dev-plugin.ts status",
    "dev:plugin:remove": "tsx scripts/dev-plugin.ts remove",
    "typecheck": "tsc --noEmit",
    "test": "bun test --path-ignore-patterns _tmp_",
    "check:release": "tsx scripts/check-release.ts",
    "check:pr-policy": "tsx scripts/validate-pr-policy.ts",
    "test:package": "tsx scripts/test-packed-package.ts",
    "release:prepare": "tsx scripts/prepare-release.ts",
    "release:create": "tsx scripts/create-release.ts",
    "package:agent-plugin": "node scripts/package-agent-plugin.mjs",
    "package:codex-plugin": "node scripts/package-codex-plugin.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@alicloud/log": "^1.2.6",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "@napi-rs/keyring": "^2.1.2",
    "@openai/mcp-extensions": "^0.2.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "compare-versions": "^6.1.1",
    "exceljs": "^4.4.0",
    "open": "^10.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.1",
    "bun-types": "^1.3.13",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "tailwindcss": "^4.1.17",
    "vite": "^7.2.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SolveaCX/cx_claw_codex.git"
  },
  "license": "UNLICENSED"
}
