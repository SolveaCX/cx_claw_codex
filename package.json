{
  "name": "@shulex/cxclawctl",
  "version": "0.1.2",
  "description": "Solvea CXClaw CLI and Codex plugin runtime",
  "type": "module",
  "bin": { "cxclawctl": "./bin/cxclawctl.mjs" },
  "files": [
    "bin",
    "dist/cli.js",
    "dist/cli.js.map",
    "skills/**/scripts/**",
    "skills/**/assets/**",
    "skills/__lib__/**",
    "skills/solvea-desk/references/report/*.html",
    "skills/solvea-desk/references/report/*.css",
    "capabilities.lock.json",
    "requirements-cli.txt"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test --path-ignore-patterns _tmp_",
    "check:capabilities": "python3 scripts/check_capabilities.py",
    "check:release": "tsx scripts/check-release.ts",
    "test:package": "tsx scripts/test-packed-package.ts",
    "release:prepare": "tsx scripts/prepare-release.ts",
    "package:agent-plugin": "node scripts/package-agent-plugin.mjs",
    "package:codex-plugin": "node scripts/package-codex-plugin.mjs"
  },
  "engines": { "node": ">=22" },
  "dependencies": {
    "@alicloud/log": "^1.2.6",
    "@napi-rs/keyring": "^2.1.2",
    "compare-versions": "^6.1.1",
    "open": "^10.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "bun-types": "^1.3.13",
    "tsup": "^8.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0"
  },
  "repository": { "type": "git", "url": "git+https://github.com/SolveaCX/cx_claw_codex.git" },
  "license": "UNLICENSED"
}
